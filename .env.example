# =============================================================================
# Tech Hacks AI — Environment Variables Configuration
# =============================================================================
# Copy this file to `.env.local` for local development.
# In production (e.g. Vercel dashboard), configure these in Project Settings -> Environment Variables.
# NEVER commit `.env` or `.env.local` containing real API secrets to source control.
# =============================================================================

# -----------------------------------------------------------------------------
# Frontend Configuration (Client-Side Safe, prefixed with VITE_)
# -----------------------------------------------------------------------------
# Production or staging canonical domain origin.
# Example: https://techhacksai.com or https://staging.techhacksai.com
# Default fallback: https://techhacksai.com
VITE_SITE_URL=https://techhacksai.com

# -----------------------------------------------------------------------------
# AI Assistant & Chatbot (Server-Side Secrets, /api/chat)
# -----------------------------------------------------------------------------
# Optional Groq API Key for production Llama 3.3 70B live chatbot responses.
# Get your API key at: https://console.groq.com/keys
# If omitted or unavailable, the assistant gracefully uses the client-side
# grounded catalog retrieval engine with 1,000+ verified tools.
GROQ_API_KEY=

# Optional Google Gemini API Key for multimodal model inference.
# Get your API key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# -----------------------------------------------------------------------------
# Moderation & Administration (Server-Side Secrets, /api/submissions)
# -----------------------------------------------------------------------------
# Required for production moderation of community tool & guide submissions.
# Used to authenticate /admin and PATCH /api/submissions requests.
# Generate a strong, random 32+ character secret for production.
# Example: openssl rand -base64 32
ADMIN_SECRET=techhacks-admin-change-me-in-production

# -----------------------------------------------------------------------------
# Durable Cloud Database Storage (Required for Production / Vercel Submissions)
# -----------------------------------------------------------------------------
# In local development and test suites, submissions persist to `data/*.json`.
# In serverless/production (e.g. Vercel), local /tmp is ephemeral and wiped on cold starts.
# To prevent silent data loss, configure Supabase (PostgreSQL REST via native fetch):
#
# 1. Create a free project at: https://supabase.com
# 2. Run the DDL script in `server/schema.sql` inside the Supabase SQL Editor.
# 3. Fill in your project URL and service role key below:
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# (Optional Alternative) Upstash Serverless Redis REST credentials:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# -----------------------------------------------------------------------------
# Optional Advertising & Analytics
# -----------------------------------------------------------------------------
# Google AdSense Publisher ID (format: ca-pub-XXXXXXXXXXXXXXXX)
# Keep empty until formal Google AdSense account approval.
# VITE_ADSENSE_PUB_ID=

