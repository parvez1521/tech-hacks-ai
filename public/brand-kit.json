{
  "name": "SwitchRoute",
  "version": "2.0",
  "updated": "2026-11",
  "purpose": "A clear, useful route through AI tools, software alternatives, open-source projects, and browser utilities.",
  "tagline": "Free AI Tools, Smarter Alternatives & Open Source",
  "brandPromise": "Find a smarter route to your tools.",
  "personality": [
    "Useful",
    "Clear",
    "Curious",
    "Independent",
    "Transparent",
    "Modern"
  ],
  "typography": {
    "family": "Bricolage Grotesque for display headings, Inter for interface text, -apple-system, BlinkMacSystemFont, Segoe UI, Roboto, sans-serif",
    "display": {
      "size": "48\u201360px",
      "weight": 800,
      "tracking": "tight"
    },
    "heading": {
      "size": "24\u201332px",
      "weight": 700
    },
    "body": {
      "size": "14\u201318px",
      "weight": 400,
      "lineHeight": 1.6
    },
    "metadata": {
      "size": "11\u201312px",
      "weight": 600,
      "letterSpacing": "0.08\u20130.14em",
      "transform": "uppercase"
    }
  },
  "colors": {
    "midnight": {
      "hex": "#160A07",
      "rgb": "22 10 7",
