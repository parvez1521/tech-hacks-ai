  "logo": {
    "preferred": "Use the supplied SwitchRoute route-mark SVG and keep its original proportions and gradient.",
    "clearSpace": "At least the width of one route endpoint around the mark.",
    "doNot": [
      "Stretch or redraw the mark",
      "Add shadows or effects to static logo files",
      "Use the old Tech Hacks AI name as the current wordmark"
    ]
  },
  "voice": {
    "use": [
      "Direct, useful language",
      "Explain free access and limits precisely",
      "Link to official pricing, product, and licensing sources",
      "State uncertainty or dated verification clearly"
