  "gradient": {
    "name": "Route gradient",
    "css": "linear-gradient(90deg, #FF6A00 0%, #F93A12 52%, #FFB800 100%)"
  },
  "layout": {
    "spacingBase": "4px",
    "spacingScalePx": [
      4,
      8,
      12,
      16,
      24,
      32,
      48,
      64
    ],
    "radius": {
      "control": "8\u201310px",
      "card": "16px",
      "feature": "24px"
    },
    "borderWidth": "1px",
    "motion": "Subtle 160\u2013220ms transitions; respect prefers-reduced-motion."
  },
  "logo": {
    "preferred": "Use the supplied SwitchRoute route-mark SVG and keep its original proportions and gradient.",
    "clearSpace": "At least the width of one route endpoint around the mark.",
    "doNot": [
      "Stretch or redraw the mark",
      "Add shadows or effects to static logo files",
      "Use the old Tech Hacks AI name as the current wordmark"
    ]
  },
  "voice": {
    "use": [
      "Direct, useful language",
      "Explain free access and limits precisely",
      "Link to official pricing, product, and licensing sources",
      "State uncertainty or dated verification clearly"
    ],
    "avoid": [
      "Unsupported #1/best claims",
      "Calling a trial unlimited or completely free",
      "Implying endorsement without evidence"
    ]
  },
  "accessibility": {
    "contrast": "Meet WCAG contrast guidance for text and controls.",
    "focus": "Keep keyboard focus visible.",
    "color": "Do not use colour alone to communicate status.",
    "motion": "Respect prefers-reduced-motion."
  },
  "assets": {
    "routeMark": "/favicon.svg",
    "socialCard": "/social-card.svg",
    "brandKitPage": "https://switchroute.in/brand-kit"
  }
