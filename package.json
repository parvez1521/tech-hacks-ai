{
  "name": "switchroute",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run logos:runtime && npm run prompts:runtime && vite",
    "build": "npm run prompts:sitemap && npm run logos:runtime && npm run prompts:runtime && vite build && npm run seo:prerender",
    "preview": "vite preview",
    "pretest": "npm run logos:runtime && npm run prompts:runtime && ./node_modules/.bin/esbuild src/App.tsx --bundle --platform=node --format=esm --external:react --external:react-dom --external:lucide-react --outfile=dist/test-ssr.js",
    "test": "node --experimental-strip-types --test --test-concurrency=1 tests/*.test.js",
    "logos:sync": "node scripts/sync-official-ai-logo-assets.mjs",
    "logos:runtime": "node scripts/generate-runtime-logo-manifest.mjs",
    "db:migrate": "node scripts/migrate-to-supabase.js",
    "prompts:sitemap": "node --experimental-strip-types scripts/generate-prompt-sitemap.mjs",
    "prompts:runtime": "node scripts/generate-promptfeed-runtime.mjs",
    "prompts:import": "node --experimental-strip-types scripts/import-prompts.mjs",
    "prompts:import:faymas": "node scripts/import-faymas-prompts.mjs",
    "prompts:download:promptfeed": "node scripts/download-promptfeed.mjs",
    "prompts:audit": "node --experimental-strip-types scripts/audit-prompt-assets.mjs --write --check",
    "prompts:audit:remote": "node --experimental-strip-types scripts/audit-prompt-assets.mjs --write --check-remote --check",
    "seo:prerender": "node scripts/prerender-site.mjs"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "busboy": "^1.6.0",
    "clsx": "^2.1.0",
    "lucide-react": "^0.344.0",
    "motion": "^14.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^2.2.1"
  },
  "devDependencies": {
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.18",
    "axe-core": "^4.14.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "vite": "^5.1.4"
  }
}
